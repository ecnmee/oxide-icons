{
  "name": "oxide-icons",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "SVG icon system with a native Web Component and isolation between icon families. In active development, see docs/en/adr/README.md.",
  "license": "MIT",
  "keywords": [
    "svg",
    "icons",
    "icon-library",
    "web-component",
    "custom-elements",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecnmee/oxide-icons.git"
  },
  "homepage": "https://github.com/ecnmee/oxide-icons#readme",
  "bugs": {
    "url": "https://github.com/ecnmee/oxide-icons/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin/index.d.ts",
      "default": "./dist/vite-plugin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:catalog": "node generate-catalog.mjs",
    "typecheck": "node generate-catalog.mjs && tsc --noEmit",
    "build": "node generate-catalog.mjs && tsc && node fix-esm-extensions.mjs",
    "test": "node generate-catalog.mjs && vitest run",
    "verify:published": "node scripts/verify-published-package.mjs",
    "example:dev": "vite --config examples/basic/vite.config.ts",
    "example:build": "vite build --config examples/basic/vite.config.ts",
    "release:sync": "node scripts/release-sync.mjs",
    "release:sync:dry-run": "node scripts/release-sync.mjs --dry-run"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/node": "^22.5.0",
    "jsdom": "^25.0.0",
    "vite": "^5.4.21"
  }
}
